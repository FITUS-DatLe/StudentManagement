  <property name="styleSheet">
   <string notr="true">
QMainWindow, QWidget#centralwidget { background-color: #F4F6F9; }
QFrame#frameHeader { background-color: #1E3A8A; border-bottom: 2px solid #1D4ED8; }
QLabel#lblHeaderTitle { color: #FFFFFF; font-size: 16px; font-weight: bold; }
QLabel#lblUserInfo { color: #E0F2FE; font-size: 13px; font-weight: bold; }
QFrame#frameSidebar, QFrame#frameContent { background-color: #FFFFFF; border: 1px solid #D1D5DB; border-radius: 8px; }
QLabel#lblSidebarTitle { color: #1E3A8A; font-size: 13px; font-weight: bold; border-bottom: 1px solid #E2E8F0; padding-bottom: 5px; }
QListWidget#listMajors { border: none; background-color: transparent; font-size: 13px; outline: 0; }
QListWidget#listMajors::item { padding: 12px 10px; border-radius: 6px; margin-bottom: 4px; color: #334155; font-weight: bold; }
QListWidget#listMajors::item:hover { background-color: #F1F5F9; color: #1E3A8A; }
QListWidget#listMajors::item:selected { background-color: #2563EB; color: #FFFFFF; }
QFrame#frameStats { background-color: #F8FAFC; border: 1px dashed #CBD5E1; border-radius: 6px; }
QLabel#lblStatTitle { color: #0F172A; font-size: 12px; font-weight: bold; }
QLabel#lblStatTotal, QLabel#lblStatIT, QLabel#lblStatMath, QLabel#lblStatBio, QLabel#lblStatScholar { color: #475569; font-size: 12px; font-weight: bold; }
QLineEdit#txtSearch { padding: 6px 12px; border: 1px solid #CBD5E1; border-radius: 6px; background-color: #F8FAFC; color: #0F172A; font-size: 13px; }
QLineEdit#txtSearch:focus { border: 2px solid #2563EB; background-color: #FFFFFF; }
QComboBox#cboSort { padding: 6px 10px; border: 1px solid #CBD5E1; border-radius: 6px; background-color: #FFFFFF; color: #334155; font-size: 13px; font-weight: bold; }
QPushButton#btnAdd { background-color: #2563EB; color: white; font-weight: bold; border-radius: 6px; font-size: 13px; }
QPushButton#btnAdd:hover { background-color: #1D4ED8; }
QPushButton#btnEdit { background-color: #F59E0B; color: white; font-weight: bold; border-radius: 6px; font-size: 13px; }
QPushButton#btnEdit:hover { background-color: #D97706; }
QPushButton#btnDelete { background-color: #EF4444; color: white; font-weight: bold; border-radius: 6px; font-size: 13px; }
QPushButton#btnDelete:hover { background-color: #DC2626; }
QTableWidget#tblStudents { border: 1px solid #E2E8F0; border-radius: 6px; background-color: #FFFFFF; gridline-color: #F1F5F9; selection-background-color: #DBEAFE; selection-color: #1E3A8A; font-size: 13px; outline: 0; }
QHeaderView::section { background-color: #F8FAFC; color: #334155; font-weight: bold; border: none; border-bottom: 2px solid #CBD5E1; border-right: 1px solid #E2E8F0; padding: 8px; font-size: 13px; }
